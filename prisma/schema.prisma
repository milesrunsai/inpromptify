generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  clerkOrgId    String         @unique
  members       Membership[]
  assessments   Assessment[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
}

model Membership {
  id     String       @id @default(cuid())
  org    Organization @relation(fields: [orgId], references: [id])
  orgId  String
  user   User         @relation(fields: [userId], references: [id])
  userId String
  role   Role         @default(MEMBER)
}

model User {
  id          String       @id @default(cuid())
  clerkUserId String       @unique
  email       String       @unique
  memberships Membership[]
}

model Assessment {
  id              String           @id @default(cuid())
  org             Organization     @relation(fields: [orgId], references: [id])
  orgId           String
  candidateEmail  String
  status          AssessmentStatus
  score           Int?
  dimensionScores Json?
  responses       Json[]
  currentTheta    Float            @default(50.0)
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
}

model QuestionBank {
  id              String    @id @default(cuid())
  text            String
  options         Json      // [{id: "A", text: "...", isCorrect: true}, ...]
  correctOptionId String
  difficulty      Int       // 1-100
  dimensions      Json      // ["promptQuality", "responseQuality"]
  tags            String[]
  maxTimeSeconds  Int
  irtA            Float?
  irtB            Float?
  irtC            Float?
  lastCalibrated  DateTime?
  createdAt       DateTime  @default(now())
  isActive        Boolean   @default(true)
}

model PendingQuestion {
  id              String   @id @default(cuid())
  text            String
  options         Json     // [{id: "A", text: "...", isCorrect: true}, ...]
  correctOptionId String
  difficulty      Int      // 1-100
  dimensions      Json     // ["promptQuality", "responseQuality"]
  tags            String[]
  maxTimeSeconds  Int
  source          String   @default("manual") // llm-generated, manual, community
  status          String   @default("pending") // pending, approved, rejected
  reviewedBy      String?
  createdAt       DateTime @default(now())
}

model CalibrationResponse {
  id               String   @id @default(cuid())
  assessmentId     String?
  questionId       String
  selectedOptionId String
  wasCorrect       Boolean
  timeTakenMs      Int
  createdAt        DateTime @default(now())
}

model Subscription {
  id          String       @id @default(cuid())
  org         Organization @relation(fields: [orgId], references: [id])
  orgId       String
  stripeSubId String       @unique
  tier        Tier
  credits     Int
  status      String
}

enum Role {
  ADMIN
  MEMBER
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Tier {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

model DemoBooking {
  id           String   @id @default(cuid())
  name         String
  email        String
  company      String?
  teamSize     String?
  date         DateTime
  time         String
  message      String?
  status       String   @default("pending") // pending, confirmed, cancelled
  createdAt    DateTime @default(now())
}
